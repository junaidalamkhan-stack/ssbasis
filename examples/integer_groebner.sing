// integer_groebner.sing -- the computation behind "this holds over every field"
// in Example 4.4 of the revised manuscript (numbering as in the revised version).
// A strong standard basis G of J = <Y_i - LF(h_i)> in Z[x,y,Y] is computed for
// an elimination order for x,y.  If every leading coefficient of G is +1 or -1,
// then G reduces modulo every prime p to a Groebner basis of J mod p, so the
// x,y-free elements of G generate ker(pi) over F_p, hence over every field of
// characteristic p; the same elements generate ker(pi) over Q.  The script also
// checks that these elements generate the same ideal as the generators in the
// text.  Examples 4.5 and its completion are included as further checks (their
// kernels are determined by hand in the text).
proc allunit(ideal G)
{
  int i;
  for (i = 1; i <= ncols(G); i++)
  {
    if ((leadcoef(G[i]) != 1) && (leadcoef(G[i]) != -1)) { return(0); }
  }
  return(1);
}
proc xyfree(ideal G)
{
  ideal E; int i; int k = 0;
  for (i = 1; i <= ncols(G); i++)
  {
    if (G[i] == subst(subst(G[i], x, 0), y, 0)) { k++; E[k] = G[i]; }
  }
  return(E);
}
proc sameideal(ideal A, ideal B)
{
  return((size(reduce(A, std(B))) == 0) && (size(reduce(B, std(A))) == 0));
}

"===== Example 4.4: h = x+y, xy, x2-x, x3-x; leading forms x+y, xy, x2, x3 =====";
ring r44 = integer,(x,y,Y1,Y2,Y3,Y4),(dp(2),dp(4));
ideal G = std(ideal(Y1-(x+y), Y2-xy, Y3-x2, Y4-x3));
"all leading coefficients +1 or -1:"; allunit(G);
ideal C = Y2*Y3+Y3^2-Y1*Y4, Y1^2*Y3-Y2^2+Y3^2-2*Y1*Y4, Y1*Y3^2-Y2*Y4-Y3*Y4, Y3^3-Y4^2;
"x,y-free elements generate <c1,c2,c3,c4> over Z:"; sameideal(xyfree(G), C);
kill r44;

"===== Example 4.5: leading forms x2, xy, y2, y3 =====";
ring r45 = integer,(x,y,Y1,Y2,Y3,Y4),(dp(2),dp(4));
ideal G = std(ideal(Y1-x2, Y2-xy, Y3-y2, Y4-y3));
"all leading coefficients +1 or -1:"; allunit(G);
ideal C = Y2^2-Y1*Y3, Y3^3-Y4^2;
"x,y-free elements generate <c1,c2> over Z:"; sameideal(xyfree(G), C);
kill r45;

"===== Example 4.5 after completion: h5 = y, leading forms x2, xy, y2, y3, y =====";
ring r45c = integer,(x,y,Y1,Y2,Y3,Y4,Y5),(dp(2),dp(5));
ideal G = std(ideal(Y1-x2, Y2-xy, Y3-y2, Y4-y3, Y5-y));
"all leading coefficients +1 or -1:"; allunit(G);
ideal C = Y3-Y5^2, Y4-Y3*Y5, Y2^2-Y1*Y3;
"x,y-free elements generate <Y3-Y5^2, Y4-Y3*Y5, Y2^2-Y1*Y3> over Z:"; sameideal(xyfree(G), C);
kill r45c;
quit;
