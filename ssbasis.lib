////////////////////////////////////////////////////////////////////////////
version="version ssbasis.lib 1.1 (revised) Oct_2026 ";
category="Commutative Algebra";
info="
LIBRARY:  ssbasis.lib    Subalgebra standard bases (SS-bases): lifting test and completion
AUTHORS:  Anum Abbas, Junaid Alam Khan

OVERVIEW:
 Setting.  Let A be the coefficient domain of the basering (a field, ZZ or
 ZZ/m) and let R = A[x_1,...,x_n]/I, where I is the quotient ideal of the
 basering (I = 0 for a polynomial ring).  A grading is given by a k x n
 intmat W with non-negative entries: the degree of x^a is W*a in N^k, and
 degrees are compared lexicographically, first row first.  The ideal I must
 be W-homogeneous.  Variables whose column of W is zero have degree 0; they
 belong to the coefficient ring S = R_0 of the theory, which is then
 (A[those variables]/(I intersected with that ring)).

 Method.  For F = {f_1,...,f_m} the procedures work in auxiliary rings
 A[x_+, x_0, Y_1..Y_m] (x_+ the variables of positive degree, x_0 those of
 degree 0).  Generators of ker(pi) and ker(psi) are obtained by eliminating
 x_+ from I + <Y_i - LF(f_i)> and I + <Y_i - f_i>; the elimination
 ideal is homogeneous because all input polynomials are.  A homogeneous u
 in ker(pi) is tested for liftability by reducing it modulo a standard basis
 of ker(psi) for a global order refining the formal degree Omega: u admits
 a lifting iff the remainder is 0 or has smaller Omega (over ZZ and ZZ/m this
 uses Singular's strong standard bases).  Subalgebra reduction (Algorithm 1,
 line 7) decides whether a leading form lies in S[LF(F)] by a normal form
 modulo a standard basis of I + <Y_i - LF(f_i)> for an elimination order.

 Supported input: coefficients a field (including char p and transcendental
 parameters), ZZ or ZZ/m; polynomial rings and quotient rings by
 W-homogeneous ideals; global monomial orderings; W with non-negative
 integer entries and at least one nonzero column.  Unsupported input
 (negative weights, local orderings, inhomogeneous quotient ideals,
 floating-point coefficients, generators that are zero in R) raises an
 ERROR.  SScomplete runs at most a given number of passes, because
 Algorithm 1 need not terminate.

PROCEDURES:
 ssNatural();            1 x n matrix of ones: natural grading
 ssLex();                n x n identity matrix: leading terms for lp
 ssCheckInput(G,W);      validate the input; ERROR if it is not supported
 ssPolyDeg(p,W);         degree of p in R (as an intvec)
 ssLeadForm(p,W);        leading form of p in R
 SSliftingData(G,W);     verdict, leading forms, ker(pi), liftings (list)
 SSliftingTest(G,W);     the same as a printable report
 SScomplete(G,W,b);      Algorithm 1 (completion) with at most b passes
";

LIB "ring.lib";

////////////////////////////////////////////////////////////////////////////
// elementary helpers (the first five are unchanged from version 1.0)

proc ssLexCmp(intvec a, intvec b)
"USAGE:  ssLexCmp(a,b);  a,b intvec of equal length
RETURN:  -1, 0 or 1 according as a < b, a = b, a > b lexicographically
"
{
  int i;
  for (i = 1; i <= size(a); i++)
  {
    if (a[i] != b[i]) { if (a[i] < b[i]) { return(-1); } return(1); }
  }
  return(0);
}

proc ssExpDeg(intvec e, intmat M)
"USAGE:  ssExpDeg(e,M);  e an exponent vector, M a weight matrix
RETURN:  the intvec M*e (only the first ncols(M) entries of e are used)
"
{
  int j, l; intvec d = 0:nrows(M);
  for (j = 1; j <= nrows(M); j++)
  { for (l = 1; l <= ncols(M); l++) { d[j] = d[j] + M[j,l]*e[l]; } }
  return(d);
}

proc ssNatural()
"USAGE:  ssNatural();
RETURN:  the 1 x nvars(basering) intmat of ones (natural grading)
"
{
  int l; intmat M[1][nvars(basering)];
  for (l = 1; l <= nvars(basering); l++) { M[1,l] = 1; }
  return(M);
}

proc ssLex()
"USAGE:  ssLex();
RETURN:  the nvars x nvars identity intmat; the leading form of p is then
         the leading term of p for the lexicographic order x_1 > ... > x_n
"
{
  int l; intmat M[nvars(basering)][nvars(basering)];
  for (l = 1; l <= nvars(basering); l++) { M[l,l] = 1; }
  return(M);
}

static proc ssRed(poly p)
{
  // reduced representative of p modulo the quotient ideal of the basering
  if (size(ideal(basering)) == 0) { return(p); }
  return(reduce(p, std(ideal(0))));
}

static proc ssIsHomog(poly p, intmat W)
{
  int i; intvec d0;
  if (p == 0) { return(1); }
  d0 = ssExpDeg(leadexp(p[1]), W);
  for (i = 2; i <= size(p); i++)
  { if (ssLexCmp(ssExpDeg(leadexp(p[i]), W), d0) != 0) { return(0); } }
  return(1);
}

static proc ssRawDeg(poly p, intmat W)
{
  // degree of a nonzero polynomial, no reduction
  int i; intvec d; intvec best = ssExpDeg(leadexp(p[1]), W);
  for (i = 2; i <= size(p); i++)
  { d = ssExpDeg(leadexp(p[i]), W); if (ssLexCmp(best, d) == -1) { best = d; } }
  return(best);
}

proc ssPolyDeg(poly p, intmat W)
"USAGE:  ssPolyDeg(p,W);  p poly, W intmat (one column per variable)
RETURN:  the degree upsilon(p) in R, as an intvec; ERROR if p = 0 in R
NOTE:    in a quotient ring, p is first replaced by its normal form modulo
         the quotient ideal
"
{
  p = ssRed(p);
  if (p == 0) { ERROR("ssPolyDeg: the polynomial is zero in R"); }
  return(ssRawDeg(p, W));
}

proc ssLeadForm(poly p, intmat W)
"USAGE:  ssLeadForm(p,W);  p poly, W intmat (one column per variable)
RETURN:  the leading form Upsilon(p) in R (0 if p = 0 in R)
"
{
  p = ssRed(p);
  if (p == 0) { return(p); }
  int i; poly lf = 0; intvec top = ssRawDeg(p, W);
  for (i = 1; i <= size(p); i++)
  { if (ssLexCmp(ssExpDeg(leadexp(p[i]), W), top) == 0) { lf = lf + p[i]; } }
  return(lf);
}

proc ssCheckInput(ideal G, intmat W)
"USAGE:  ssCheckInput(G,W);  G ideal (the generators f_i), W intmat
RETURN:  1 if the input is supported; otherwise an ERROR explains why
"
{
  int n = nvars(basering); int i, j, nz;
  if (ncols(W) != n)
  { ERROR("W must have exactly one column per ring variable"); }
  for (i = 1; i <= nrows(W); i++)
  {
    for (j = 1; j <= n; j++)
    {
      if (W[i,j] < 0)
      { ERROR("W has a negative entry: only N^k-gradings (non-negative weights) are supported"); }
    }
  }
  for (j = 1; j <= n; j++)
  {
    nz = 0;
    for (i = 1; i <= nrows(W); i++) { if (W[i,j] != 0) { nz = 1; } }
    if (nz) { break; }
  }
  if (!nz) { ERROR("every column of W is zero: there is no variable of positive degree"); }
  if (!hasGlobalOrdering(basering))
  { ERROR("the basering must have a global monomial ordering"); }
  string cs = charstr(basering);
  if (find(cs, "real") || find(cs, "Float") || find(cs, "complex"))
  { ERROR("floating-point coefficients are not supported"); }
  ideal I = ideal(basering);
  for (i = 1; i <= ncols(I); i++)
  {
    if (!ssIsHomog(I[i], W))
    { ERROR("the quotient ideal is not homogeneous for the grading W"); }
  }
  if (size(G) == 0) { ERROR("no nonzero generators given"); }
  for (i = 1; i <= ncols(G); i++)
  {
    if (ssRed(G[i]) == 0)
    { ERROR("generator " + string(i) + " is zero in R"); }
    for (j = 1; j <= n; j++)
    {
      if (varstr(j) == "Y" + string(i))
      { ERROR("the ring variable " + varstr(j) + " clashes with the auxiliary variables Y1,Y2,...; please rename it"); }
    }
  }
  return(1);
}

static proc ssOmega(intvec e, intmat D, int off)
{
  // formal degree of the monomial with exponent vector e, whose Y-exponents
  // start at position off+1
  int j, i; intvec d = 0:nrows(D);
  for (j = 1; j <= nrows(D); j++)
  { for (i = 1; i <= ncols(D); i++) { d[j] = d[j] + D[j,i]*e[off+i]; } }
  return(d);
}

static proc ssOmegaPoly(poly p, intmat D, int off)
{
  int i; intvec d; intvec best = ssOmega(leadexp(p[1]), D, off);
  for (i = 2; i <= size(p); i++)
  { d = ssOmega(leadexp(p[i]), D, off); if (ssLexCmp(best, d) == -1) { best = d; } }
  return(best);
}

static proc ssXfree(poly p, int np)
{
  // 1 if no term of p involves the first np variables
  int i, j; intvec e;
  for (i = 1; i <= size(p); i++)
  {
    e = leadexp(p[i]);
    for (j = 1; j <= np; j++) { if (e[j] != 0) { return(0); } }
  }
  return(1);
}

////////////////////////////////////////////////////////////////////////////
// the core computation

static proc ssCore(ideal G, intmat W, int allnf)
{
  // allnf = 0: compute an S-normal form of psi(u) only for non-liftable u
  // allnf = 1: compute one for every u (one pass of Algorithm 1)
  // RETURN: list(ok, LFstrings, D, Ustrings, OmegaStrings, liftStrings, N)
  //         N = ideal of the nonzero normal forms (in the basering)
  int chk = ssCheckInput(G, W);
  def R = basering;
  int n = nvars(R); int m = ncols(G); int k = nrows(W);
  int i, j, l, np, nz, nzc;
  ideal GG; ideal LF; intmat D[k][m]; intvec dg;
  list LFs;
  for (i = 1; i <= m; i++)
  {
    GG[i] = ssRed(G[i]);
    dg = ssRawDeg(GG[i], W); LF[i] = ssLeadForm(GG[i], W);
    for (j = 1; j <= k; j++) { D[j,i] = dg[j]; }
    LFs[i] = string(LF[i]);
  }
  ideal IR = ideal(R);
  // variables of positive degree and of degree zero
  intvec pos, zer;
  for (i = 1; i <= n; i++)
  {
    nzc = 0;
    for (j = 1; j <= k; j++) { if (W[j,i] != 0) { nzc = 1; } }
    if (nzc) { np++; pos[np] = i; } else { nz++; zer[nz] = i; }
  }
  // auxiliary ring E = A[x_+, x_0, Y], elimination order for x_+,
  // then the rows of D as weights on (x_0, Y), then dp
  list RL = ringlist(R); list nmR = RL[2]; list nmE; list nmQ;
  for (i = 1; i <= np; i++) { nmE[i] = nmR[pos[i]]; }
  for (i = 1; i <= nz; i++) { nmE[np+i] = nmR[zer[i]]; nmQ[i] = nmR[zer[i]]; }
  for (i = 1; i <= m; i++) { nmE[np+nz+i] = "Y" + string(i); nmQ[nz+i] = "Y" + string(i); }
  list ordE; list ordQ; intvec row;
  ordE[1] = list("dp", 1:np);
  for (j = 1; j <= k; j++)
  {
    row = 0:(nz+m);
    for (i = 1; i <= m; i++) { row[nz+i] = D[j,i]; }
    ordE[j+1] = list("a", row); ordQ[j] = list("a", row);
  }
  ordE[k+2] = list("dp", 1:(nz+m)); ordE[k+3] = list("C", intvec(0));
  ordQ[k+1] = list("dp", 1:(nz+m)); ordQ[k+2] = list("C", intvec(0));
  list RE = RL; RE[2] = nmE; RE[3] = ordE; RE[4] = ideal(0);
  list RD = RL; RD[2] = nmE; RD[3] = list(list("dp", 1:(np+nz+m)), list("C", intvec(0))); RD[4] = ideal(0);
  list RQ = RL; RQ[2] = nmQ; RQ[3] = ordQ; RQ[4] = ideal(0);
  def E = ring(RE);
  def Q = ring(RQ);
  def ED = ring(RD);
  // maps back to R
  setring R;
  ideal imE, imQ;
  for (i = 1; i <= np; i++) { imE[i] = var(pos[i]); }
  for (i = 1; i <= nz; i++) { imE[np+i] = var(zer[i]); imQ[i] = var(zer[i]); }
  for (i = 1; i <= m; i++) { imE[np+nz+i] = GG[i]; imQ[nz+i] = GG[i]; }
  map psiE = E, imE;
  map psiQ = Q, imQ;
  // eliminations
  setring E;
  ideal IE = imap(R, IR); ideal GE = imap(R, GG); ideal LFE = imap(R, LF);
  ideal Jpsi = IE; ideal Jpi = IE;
  for (i = 1; i <= m; i++)
  {
    Jpsi[ncols(Jpsi)+1] = var(np+nz+i) - GE[i];
    Jpi[ncols(Jpi)+1] = var(np+nz+i) - LFE[i];
  }
  Jpsi = simplify(Jpsi, 2); Jpi = simplify(Jpi, 2);
  // ker(psi): elimination of x_+ with eliminate() in a ring with the order dp
  // (much faster here than a standard basis for the block order of E,
  // because Jpsi is inhomogeneous)
  setring ED;
  ideal JpsiD = imap(E, Jpsi); ideal IED = imap(E, IE);
  poly xprod = 1;
  for (i = 1; i <= np; i++) { xprod = xprod * var(i); }
  ideal KpsiD = simplify(eliminate(JpsiD, xprod), 2);
  ideal K0D = simplify(eliminate(IED, xprod), 2);
  setring E;
  ideal Kpsi = imap(ED, KpsiD);
  ideal K0 = imap(ED, K0D);
  // ker(pi): x_+-free part of a standard basis of Jpi for the block order,
  // which is also needed for the subalgebra reduction below
  ideal SBpi = std(Jpi);
  ideal Kpi;
  for (i = 1; i <= ncols(SBpi); i++)
  { if (SBpi[i] != 0) { if (ssXfree(SBpi[i], np)) { Kpi[ncols(Kpi)+1] = SBpi[i]; } } }
  Kpsi = simplify(Kpsi, 2); Kpi = simplify(Kpi, 2);
  // I_0 = I intersected with A[x_0]: relations that are already zero in S[Y]
  poly nf, Qg; intvec e;
  // the ring Q = A[x_0, Y] with an order refining Omega
  setring Q;
  ideal KP = std(imap(E, Kpsi));
  ideal U0 = imap(E, Kpi);
  ideal I0 = std(imap(E, K0));
  // split into Omega-homogeneous components (they lie in ker(pi))
  ideal U; poly c; intvec om, om2; list seen; int found;
  for (i = 1; i <= ncols(U0); i++)
  {
    if (U0[i] != 0)
    {
    seen = list();
    for (j = 1; j <= size(U0[i]); j++)
    {
      om = ssOmega(leadexp(U0[i][j]), D, nz);
      found = 0;
      for (l = 1; l <= size(seen); l++) { if (ssLexCmp(seen[l], om) == 0) { found = 1; } }
      if (!found)
      {
        seen[size(seen)+1] = om;
        c = 0;
        for (l = 1; l <= size(U0[i]); l++)
        { if (ssLexCmp(ssOmega(leadexp(U0[i][l]), D, nz), om) == 0) { c = c + U0[i][l]; } }
        if (c != 0) { c = reduce(c, I0); }
        if (c != 0) { U[ncols(U)+1] = c; }
      }
    }
    }
  }
  U = simplify(U, 2);
  // remove redundant generators
  ideal rest; i = ncols(U);
  while (i != 0)
  {
    if (ncols(U) > 1)
    {
      rest = U; rest[i] = 0; rest = simplify(rest, 2);
      if (size(rest) != 0) { if (reduce(U[i], std(rest + I0)) == 0) { U = rest; } }
    }
    i--;
  }
  if (size(U) == 0) { U = ideal(0); }
  // liftability (Lemma 4.1(a) of the paper)
  list Us, Oms, Lifts; int ok = 1; poly rem; list needNF;
  int nU = 0;
  for (i = 1; i <= ncols(U); i++)
  {
    if (U[i] != 0)
    {
    nU++;
    Us[nU] = string(U[i]);
    Oms[nU] = string(ssOmegaPoly(U[i], D, nz));
    rem = reduce(U[i], KP);
    if (rem == 0) { Lifts[nU] = string(U[i]); needNF[nU] = allnf; }
    else
    {
      if (ssLexCmp(ssOmegaPoly(rem, D, nz), ssOmegaPoly(U[i], D, nz)) == -1)
      { Lifts[nU] = string(U[i] - rem); needNF[nU] = allnf; }
      else { Lifts[nU] = ""; ok = 0; needNF[nU] = 1; }
    }
    }
  }
  // S-normal forms of psi(u) by subalgebra reduction (Algorithm 1, line 7)
  setring R;
  ideal PU = psiQ(U);
  ideal N; poly w, lw; intvec gam; int nn;
  list NFs;
  for (i = 1; i <= nU; i++)
  {
    NFs[i] = "";
    if (needNF[i])
    {
    w = ssRed(PU[i]);
    while (w != 0)
    {
      lw = ssLeadForm(w, W); gam = ssRawDeg(w, W);
      setring E;
      nf = reduce(imap(R, lw), SBpi);
      if (!ssXfree(nf, np)) { setring R; break; }
      Qg = 0;
      for (j = 1; j <= size(nf); j++)
      {
        e = leadexp(nf[j]);
        if (ssLexCmp(ssOmega(e, D, np+nz), gam) == 0) { Qg = Qg + nf[j]; }
      }
      setring R;
      if (psiE(Qg) == 0) { ERROR("internal error: empty reduction step"); }
      w = ssRed(w - psiE(Qg));
    }
    if (w != 0) { nn++; N[nn] = w; NFs[i] = string(w); }
    }
  }
  N = simplify(N, 2+4);
  return(list(ok, LFs, D, Us, Oms, Lifts, NFs, N));
}

////////////////////////////////////////////////////////////////////////////
// user procedures

proc SSliftingData(ideal G, intmat W)
"USAGE:  SSliftingData(G,W);  G ideal (generators f_1..f_m), W intmat
RETURN:  list L with
         L[1]  int: 1 if every computed generator of ker(pi) lifts, i.e. the
               f_i form an SS-basis of S[f_1..f_m], and 0 otherwise
         L[2]  list of strings: the leading forms Upsilon(f_i)
         L[3]  intmat D: column i is the degree of f_i
         L[4]  list of strings: homogeneous generators u_j of ker(pi)
         L[5]  list of strings: Omega(u_j)
         L[6]  list of strings: a lifting of u_j, or \"\" if none exists
         L[7]  list of strings: for non-liftable u_j, a nonzero S-normal form
               of psi(u_j) (the element Algorithm 1 adjoins), else \"\"
         L[8]  ideal of these normal forms (in the basering)
EXAMPLE: example SSliftingData; shows an example
"
{
  return(ssCore(G, W, 0));
}
example
{ "EXAMPLE:"; echo = 2;
  ring r = 0,(x,y),dp;
  ideal G = x2+y, xy, y2, y3+y;
  list L = SSliftingData(G, ssNatural());
  L[1]; L[4]; L[6]; L[7];
}

proc SSliftingTest(ideal G, intmat W)
"USAGE:  SSliftingTest(G,W);  G ideal (generators f_1..f_m), W intmat
RETURN:  string: generators, degrees and leading forms, homogeneous
         generators of ker(pi) with their formal degrees, a lifting of each
         generator or a nonzero S-normal form of psi(u) when no lifting
         exists, and the verdict of the lifting criterion
EXAMPLE: example SSliftingTest; shows an example
"
{
  list L = ssCore(G, W, 0);
  int i, j; intvec dg; intmat D = L[3];
  string out = "Generators, degrees, leading forms:" + newline;
  for (i = 1; i <= ncols(G); i++)
  {
    dg = 0:nrows(D);
    for (j = 1; j <= nrows(D); j++) { dg[j] = D[j,i]; }
    out = out + "  f" + string(i) + " = " + string(G[i]) + "   degree (" + string(dg)
              + ")   leading form: " + L[2][i] + newline;
  }
  out = out + "Generators of ker(pi): " + string(size(L[4])) + newline;
  for (i = 1; i <= size(L[4]); i++)
  {
    out = out + "u" + string(i) + " = " + L[4][i] + "   Omega (" + L[5][i] + ")" + newline;
    if (L[6][i] != "") { out = out + "   lifting: " + L[6][i] + newline; }
    else
    {
      out = out + "   NO lifting; psi(u" + string(i) + ") has the nonzero normal form "
                + L[7][i] + newline;
    }
  }
  if (L[1]) { out = out + "RESULT: every generator lifts, so the generators form an SS-basis"; }
  else { out = out + "RESULT: NOT an SS-basis"; }
  return(out);
}
example
{ "EXAMPLE:"; echo = 2;
  ring r = (integer,4),(x,y),dp;
  ideal G = xy3+y4, y3+2y, 2x+y3;
  SSliftingTest(G, ssNatural());
}

proc SScomplete(ideal G, intmat W, int maxpass)
"USAGE:  SScomplete(G,W,b);  G ideal, W intmat, b int (maximal number of passes)
RETURN:  list L: L[1] the current generating set F' (an ideal), L[2] the
         number of passes made, L[3] = 1 if the last pass adjoined nothing
         (then L[1] is an SS-basis of S[G]) and 0 if b passes were used up
NOTE:    each pass is one run of the repeat-loop of Algorithm 1: all
         homogeneous generators u of ker(pi') are reduced, and the nonzero
         S-normal forms of psi'(u) are adjoined.  Algorithm 1 terminates iff
         S[Upsilon(A)] is finitely generated; the bound b guards against
         non-termination.
EXAMPLE: example SScomplete; shows an example
"
{
  ideal F; int i, pass, done;
  for (i = 1; i <= ncols(G); i++) { F[i] = ssRed(G[i]); }
  list L; ideal N;
  for (pass = 1; pass <= maxpass; pass++)
  {
    L = ssCore(F, W, 1);
    N = L[8];
    if (size(N) == 0) { done = 1; break; }
    for (i = 1; i <= ncols(N); i++) { if (N[i] != 0) { F[ncols(F)+1] = N[i]; } }
  }
  if (pass > maxpass) { pass = maxpass; }
  return(list(F, pass, done));
}
example
{ "EXAMPLE:"; echo = 2;
  ring r = 0,(x,y),dp;
  ideal G = x2+y, xy, y2, y3+y;
  list L = SScomplete(G, ssNatural(), 5);
  L[1]; L[2]; L[3];
}
